      <simple-id uuid='{8B244671-7BCA-5135-94D2-99FBBF05B357}' />
    </worksheet>
    <worksheet name="Scorecard">
      <layout-options>
        <title>
          <formatted-text><run bold='true' fontsize='13'>The scorecard: points per attribute</run><run>Æ&#10;</run><run fontcolor='#6b7280' fontsize='10'>Score = sum of points (600 = 50:1 good:bad odds; +20 points doubles the odds).</run></formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='scorecard' name='federated.scorecard' />
          </datasources>

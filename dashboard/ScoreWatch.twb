            <column-instance column='[bad_rate]' derivation='Sum' name='[sum:bad_rate:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <sort class='computed' column='[federated.state].[none:property_state:nk]' direction='DESC' using='[federated.state].[sum:bad_rate:qk]' />
          <aggregation value='true' />
        </view>
        <style>

        </style>
        <panes>

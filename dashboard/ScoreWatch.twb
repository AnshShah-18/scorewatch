            <column-instance column='[feature]' derivation='None' name='[none:feature:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[bin]' role='dimension' type='nominal' />
            <column-instance column='[bin]' derivation='None' name='[none:bin:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[points]' role='measure' type='quantitative' />
            <column-instance column='[points]' derivation='Sum' name='[sum:points:qk]' pivot='key' type='quantitative' />

    </worksheet>
    <worksheet name="Score stability">
      <layout-options>
        <title>
          <formatted-text><run bold='true' fontsize='13'>Score stability (PSI) by origination year</run><run>Æ&#10;</run><run fontcolor='#6b7280' fontsize='10'>Vs. training population. Green &lt; 0.10 stable, amber 0.10-0.25 monitor, red &gt; 0.25 shift.</run></formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='score_psi' name='federated.score_psi' />
          </datasources>
          <datasource-dependencies datasource='federated.score_psi'>
            <column datatype='integer' name='[orig_year]' role='dimension' type='ordinal' />
            <column-instance column='[orig_year]' derivation='None' name='[none:orig_year:ok]' pivot='key' type='ordinal' />
            <column datatype='string' name='[status]' role='dimension' type='nominal' />
            <column-instance column='[status]' derivation='None' name='[none:status:nk]' pivot='key' type='nominal' />
            <column datatype='real' name='[score_psi]' role='measure' type='quantitative' />
            <column-instance column='[score_psi]' derivation='Sum' name='[sum:score_psi:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>

        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.score_psi].[none:status:nk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.score_psi].[sum:score_psi:qk]</rows>
        <cols>[federated.score_psi].[none:orig_year:ok]</cols>
      </table>
      <simple-id uuid='{270CB973-8E10-576B-894D-FC99638CF4B6}' />
    </worksheet>
    <worksheet name="Characteristic drift">
      <layout-options>
        <title>
          <formatted-text><run bold='true' fontsize='13'>Characteristic drift (CSI) by year</run><run>Æ&#10;</run><run fontcolor='#6b7280' fontsize='10'>Green stable, amber monitor, red shift. DTI shifts after 2019 (HARP-era missing DTI ends); loan purpose shifts in 2023 (refinance collapse).</run></formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='csi' name='federated.csi' />
          </datasources>
          <datasource-dependencies datasource='federated.csi'>
            <column datatype='string' name='[feature]' role='dimension' type='nominal' />
            <column-instance column='[feature]' derivation='None' name='[none:feature:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[year]' role='dimension' type='nominal' />
            <column-instance column='[year]' derivation='None' name='[none:year:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[status]' role='dimension' type='nominal' />
            <column-instance column='[status]' derivation='None' name='[none:status:nk]' pivot='key' type='nominal' />
            <column datatype='real' name='[csi]' role='measure' type='quantitative' />
            <column-instance column='[csi]' derivation='Sum' name='[sum:csi:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>

        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Square' />
            <encodings>
              <color column='[federated.csi].[none:status:nk]' />
              <tooltip column='[federated.csi].[sum:csi:qk]' />
            </encodings>
            <style>
              <style-rule element='mark'><format attr='size' value='1.6' /></style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.csi].[none:feature:nk]</rows>
        <cols>[federated.csi].[none:year:nk]</cols>
      </table>
      <simple-id uuid='{98B5056D-C85F-5B1A-9E68-7588B10A568F}' />
    </worksheet>
    <worksheet name="Calibration">
      <layout-options>
        <title>
          <formatted-text><run bold='true' fontsize='13'>Calibration traffic lights by score decile</run><run>Æ&#10;</run><run fontcolor='#6b7280' fontsize='10'>Binomial test per band (labels = actual bad rate). Fit on 2016-19. Red on 2022+ high-risk bands: defaults rose among weaker borrowers.</run></formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='calibration' name='federated.calibration' />
          </datasources>
          <datasource-dependencies datasource='federated.calibration'>
            <column datatype='string' name='[band]' role='dimension' type='nominal' />
            <column-instance column='[band]' derivation='None' name='[none:band:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[sample]' role='dimension' type='nominal' />
            <column-instance column='[sample]' derivation='None' name='[none:sample:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[traffic_light]' role='dimension' type='nominal' />
            <column-instance column='[traffic_light]' derivation='None' name='[none:traffic_light:nk]' pivot='key' type='nominal' />
            <column datatype='real' name='[bad_rate]' role='measure' type='quantitative' />
            <column-instance column='[bad_rate]' derivation='Sum' name='[sum:bad_rate:qk]' pivot='key' type='quantitative' />
            <column datatype='real' name='[predicted_pd_pit]' role='measure' type='quantitative' />
            <column-instance column='[predicted_pd_pit]' derivation='Sum' name='[sum:predicted_pd_pit:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>

        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Square' />
            <encodings>
              <color column='[federated.calibration].[none:traffic_light:nk]' />
              <text column='[federated.calibration].[sum:bad_rate:qk]' />
              <tooltip column='[federated.calibration].[sum:predicted_pd_pit:qk]' />
            </encodings>
            <style>
              <style-rule element='mark'><format attr='size' value='3.0' /><format attr='mark-labels-show' value='true' /></style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.calibration].[none:band:nk]</rows>
        <cols>[federated.calibration].[none:sample:nk]</cols>
      </table>
      <simple-id uuid='{4CB705CB-36DF-5AEA-A28B-921EB861A9CB}' />
    </worksheet>
    <worksheet name="State risk">
      <layout-options>
        <title>
          <formatted-text><run bold='true' fontsize='13'>Top 20 states by bad rate, 2005-15 loans</run><run>Æ&#10;</run><run fontcolor='#6b7280' fontsize='10'>Crisis-era geography: Florida (4.3%) and Nevada (4.2%) lead. States with at least 300 labeled loans.</run></formatted-text>
        </title>

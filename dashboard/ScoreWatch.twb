  <worksheets>
    <worksheet name="Target story">
      <layout-options>
        <title>
          <formatted-text><run bold='true' fontsize='13'>24-month bad rate by origination year</run><run>Æ&#10;</run><run fontcolor='#6b7280' fontsize='10'>Blue: forbearance excluded (model target). Orange: raw 90+ days past due. 86% of 2019 raw 'defaults' were COVID payment pauses.</run></formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='target_story' name='federated.target_story' />
          </datasources>
          <datasource-dependencies datasource='federated.target_story'>
            <column datatype='integer' name='[orig_year]' role='dimension' type='ordinal' />
            <column-instance column='[orig_year]' derivation='None' name='[none:orig_year:ok]' pivot='key' type='ordinal' />
            <column datatype='string' name='[series]' role='dimension' type='nominal' />
            <column-instance column='[series]' derivation='None' name='[none:series:nk]' pivot='key' type='nominal' />
            <column datatype='real' name='[bad_rate]' role='measure' type='quantitative' />
            <column-instance column='[bad_rate]' derivation='Sum' name='[sum:bad_rate:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>

        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Line' />
            <encodings>
              <color column='[federated.target_story].[none:series:nk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.target_story].[sum:bad_rate:qk]</rows>
        <cols>[federated.target_story].[none:orig_year:ok]</cols>
      </table>
      <simple-id uuid='{ECC13D81-41AA-58F0-88EA-256DA1CDF3C0}' />
    </worksheet>
    <worksheet name="Gini by vintage">
      <layout-options>
        <title>
          <formatted-text><run bold='true' fontsize='13'>Gini by vintage: scorecard vs. credit score alone</run><run>Æ&#10;</run><run fontcolor='#6b7280' fontsize='10'>Gini coefficient, higher is better. Blue: ScoreWatch. Gray: credit score alone. Trained on 2005-15; 2016+ is out-of-time.</run></formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='gini_by_vintage' name='federated.gini_by_vintage' />
          </datasources>
          <datasource-dependencies datasource='federated.gini_by_vintage'>
            <column datatype='integer' name='[orig_year]' role='dimension' type='ordinal' />
            <column-instance column='[orig_year]' derivation='None' name='[none:orig_year:ok]' pivot='key' type='ordinal' />
            <column datatype='string' name='[model]' role='dimension' type='nominal' />
            <column-instance column='[model]' derivation='None' name='[none:model:nk]' pivot='key' type='nominal' />
            <column datatype='real' name='[gini]' role='measure' type='quantitative' />
            <column-instance column='[gini]' derivation='Sum' name='[sum:gini:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>

        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Line' />
            <encodings>
              <color column='[federated.gini_by_vintage].[none:model:nk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.gini_by_vintage].[sum:gini:qk]</rows>
        <cols>[federated.gini_by_vintage].[none:orig_year:ok]</cols>
      </table>
      <simple-id uuid='{5F123A40-9AAA-5370-9746-6232A89E8297}' />
    </worksheet>
    <worksheet name="Rank ordering">
      <layout-options>
        <title>
          <formatted-text><run bold='true' fontsize='13'>Bad rate by score decile, all samples</run><run>Æ&#10;</run><run fontcolor='#6b7280' fontsize='10'>B01 = riskiest 10%, B10 = safest. Dark blue train, light blue test, orange 2016-19, purple COVID 2020-21, green 2022+.</run></formatted-text>
        </title>
      </layout-options>
      <table>

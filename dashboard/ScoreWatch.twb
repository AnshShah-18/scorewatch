            <mark class='Bar' />
            <encodings>
              <text column='[federated.state].[sum:bad_rate:qk]' />
            </encodings>
            <style>
              <style-rule element='mark'><format attr='mark-labels-show' value='true' /></style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.state].[none:property_state:nk]</rows>
        <cols>[federated.state].[sum:bad_rate:qk]</cols>
      </table>
      <simple-id uuid='{5F4BD68E-BFF0-547A-9980-D13DFD09813B}' />

            </encodings>
          </pane>
        </panes>
        <rows>([federated.scorecard].[none:feature:nk] / [federated.scorecard].[none:bin:nk])</rows>
        <cols></cols>
      </table>
      <simple-id uuid='{1B554B0D-1A82-561B-885A-E2A92E21BABD}' />
    </worksheet>
    <worksheet name="Points at stake">
      <layout-options>
        <title>
          <formatted-text><run bold='true' fontsize='13'>Points at stake per characteristic</run><run>Æ&#10;</run><run fontcolor='#6b7280' fontsize='10'>Max minus min points each characteristic can contribute. Credit score moves a score most; full points table is on the Scorecard tab.</run></formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='points_range' name='federated.points_range' />
